{
  "name": "@canonical/docket",
  "version": "0.1.0",
  "description": "A friend for SLA-driven OSS maintainers",
  "type": "module",
  "author": "advl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canonical/docket.git"
  },
  "homepage": "https://github.com/canonical/docket#readme",
  "bugs": "https://github.com/canonical/docket/issues",
  "bin": {
    "docket": "src/application/main.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "!src/testing",
    "!src/scripts",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.build.json",
    "check": "biome check && tsc --noEmit",
    "test": "bunx --bun vitest run",
    "test:coverage": "bunx --bun vitest run --coverage",
    "check:identity": "bun src/scripts/check-identity.ts",
    "check:secrets": "bun src/scripts/check-secrets.ts",
    "check:audit": "bun src/scripts/check-audit.ts",
    "check:licences": "bun src/scripts/check-licences.ts",
    "check:structure": "bun src/scripts/check-structure.ts",
    "self-test": "bun src/scripts/check-identity.ts --self-test && bun src/scripts/check-secrets.ts --self-test && bun src/scripts/check-audit.ts --self-test && bun src/scripts/check-licences.ts --self-test && bun src/scripts/check-structure.ts --self-test",
    "guarantees": "bun guarantees/invoker.ts tier pr",
    "guarantees:accept": "bun guarantees/invoker.ts accept",
    "guarantees:prove": "bun guarantees/prove.ts",
    "ci": "bun run check && bun run build && bun run test:coverage && bun run self-test && bun run check:identity && bun run check:secrets && bun run check:audit && bun run check:licences && bun run check:structure && bun run guarantees && bun run guarantees:prove"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@canonical/biome-config": "0.40.0",
    "@canonical/typescript-config-react": "0.45.0",
    "@types/bun": "1.4.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.2.18",
    "@vitest/coverage-v8": "5.0.3",
    "license-checker-rseidelsohn": "5.0.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@octokit/core": "7.0.8",
    "@octokit/plugin-paginate-graphql": "6.0.0",
    "@octokit/plugin-paginate-rest": "15.0.0",
    "@octokit/plugin-retry": "8.1.1",
    "@octokit/plugin-throttling": "11.0.5",
    "@opentui/core": "0.5.12",
    "@opentui/keymap": "0.5.12",
    "@opentui/react": "0.5.12",
    "@tanstack/query-core": "5.104.0",
    "bottleneck": "2.19.5",
    "proper-lockfile": "4.1.2",
    "react": "19.2.8",
    "yaml": "2.9.1"
  }
}
