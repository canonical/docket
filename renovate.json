{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>canonical/pragma-core//configs/renovate/default.json"],
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "description": "The terminal renderer is pinned to one exact version, and a new version is adopted by hand after it is checked on screen.",
      "matchPackageNames": [
        "@opentui/core",
        "@opentui/keymap",
        "@opentui/react"
      ],
      "enabled": false
    }
  ]
}
