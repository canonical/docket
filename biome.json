{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@canonical/biome-config"],
  "overrides": [
    {
      "includes": ["**/*.md"],
      "formatter": { "enabled": false }
    },
    {
      "includes": ["**/*.test.tsx", "src/testing/**", "guarantees/**"],
      "linter": {
        "rules": { "correctness": { "noComponentHookFactories": "off" } }
      }
    }
  ]
}
